# Leave blank to report unknown monetary cost. Credits/taxes are not inferred.
SEARCH_COST_USD_PER_REQUEST=
# 京东联盟开放平台（个人使用）：在联盟后台申请后填写，不要提交或发给别人
JD_UNION_APP_KEY=
JD_UNION_APP_SECRET=
